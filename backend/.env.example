# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/melagri
# OR use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/melagri

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# M-Pesa Daraja API Configuration
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox
# Use 'sandbox' for testing or 'production' for live

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@melagri.com

# Frontend URL
FRONTEND_URL=http://localhost:8001

# Admin Credentials (for first-time setup)
ADMIN_EMAIL=admin@melagri.com
ADMIN_PASSWORD=changeme123
